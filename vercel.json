{
  "buildCommand": "cd app && npm install && npm run build",
  "outputDirectory": "app/dist",
  "rewrites": [
    { "source": "/data/bundle.js", "destination": "/api/bundle" },
    { "source": "/alt", "destination": "/index.html" },
    { "source": "/live", "destination": "/index.html" },
    { "source": "/alt/live", "destination": "/index.html" },
    { "source": "/live/alt", "destination": "/index.html" },
    { "source": "/alt/live/:path*", "destination": "/:path*" },
    { "source": "/live/alt/:path*", "destination": "/:path*" },
    { "source": "/alt/:path*", "destination": "/:path*" },
    { "source": "/live/:path*", "destination": "/:path*" }
  ],
  "functions": {
    "api/bundle.js": {
      "includeFiles": "app/dist/data/*.{tsv,csv,json}"
    }
  }
}
